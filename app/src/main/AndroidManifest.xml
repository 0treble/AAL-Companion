<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- General Permissions -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="33"
        tools:ignore="ScopedStorage" />

    <!-- Temi SDK Specific Permissions -->
    <uses-permission android:name="com.robotemi.sdk.permission.RUN_SDK_SERVICE" />
    <uses-permission android:name="com.robotemi.sdk.permission.KIOSK" />
    <uses-permission android:name="com.robotemi.sdk.permission.USE_TELEPRESENCE" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.camera.any" />
    <uses-feature android:name="android.hardware.microphone.any" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Temi_elevator">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data
                android:name="com.robotemi.sdk.metadata.UI_MODE"
                android:value="4" />
        </activity>

        <!-- Other Activities -->
        <activity android:name=".SequenceActivity" />
        <activity android:name=".Settings" />

        <!-- Temi SDK Metadata -->
        <meta-data
            android:name="com.robotemi.sdk.metadata.SKILL"
            android:value="@string/app_name"/>
        <meta-data
            android:name="com.robotemi.sdk.metadata.PERMISSIONS"
            android:value="com.robotemi.permission.settings,
                           com.robotemi.permission.sequence,
                           com.robotemi.permission.map,
                           com.robotemi.permission.telepresence" />
        <meta-data
            android:name="com.robotemi.sdk.metadata.SKILL"
            android:value="@string/app_name" />
        <meta-data
            android:name="com.robotemi.sdk.metadata.KIOSK"
            android:value="true" />
        <meta-data
            android:name="com.robotemi.sdk.metadata.OVERRIDE_NLU"
            android:value="true"/>
        <meta-data
            android:name="com.robotemi.sdk.metadata.METADATA_OVERRIDE_TTS"
            android:value="true"/>
        <meta-data
            android:name="@string/metadata_override_conversation_layer"
            android:value="TRUE" />

    </application>

</manifest>
